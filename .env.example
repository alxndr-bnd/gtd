# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
BASE_URL=http://localhost:8000
TZ=Europe/Belgrade
# Sign in with Google — тот же OAuth-клиент, что у serbito (секрет GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# Коды входа на почту — Brevo SMTP serbito. Пароль: секрет EMAIL_HOST_PASSWORD.
# Пусто при DEV=1 — код пишется в лог сервера вместо письма.
SMTP_USER=8b8d77001@smtp-brevo.com
SMTP_PASSWORD=

# Postgres (Cloud SQL, инстанс serbitodb, база gtd)
# Локально, напрямую по публичному IP (твой IP должен быть в Authorized networks):
DATABASE_URL=postgresql://gtd:ПАРОЛЬ@35.187.191.28:5432/gtd?sslmode=require
# Локально: без авторизации, логин в первого пользователя
DEV=1
# В Cloud Run — через unix-сокет:
# DATABASE_URL=postgresql://gtd:ПАРОЛЬ@/gtd?host=/cloudsql/serbito:europe-west1:serbitodb
