# GTD settings template: `cp .env.example .env`, then fill in what you need.
# Local run: README.md → "Run locally". Your own server: docs/self-host.md → "Variables".
# Empty or commented out = the default, or the feature is off.

# ── Required ───────────────────────────────────────────────────────────────
# Postgres. Local run: your own database (`createdb gtd`), never production. Docker Compose ignores it.
DATABASE_URL=postgresql://localhost/gtd
# Public URL of the site; https://… = bot webhook mode and secure cookies.
BASE_URL=http://localhost:8000
# Time zone (IANA name) for "tomorrow at 10:00" and reminders.
TZ=Europe/Belgrade

# ── Sign-in methods: at least one (or DEV=1 for a local try) ───────────────
# Email codes over SMTP (STARTTLS); email sign-in is on only when SMTP_PASSWORD is set.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender of sign-in emails.
# EMAIL_FROM='"GTD" <gtd@example.com>'
# Sign in with Google: OAuth client ID (Web) with BASE_URL in Authorized JavaScript origins.
GOOGLE_CLIENT_ID=
# Telegram bot token from @BotFather; empty = bot off, the site works as usual.
TELEGRAM_BOT_TOKEN=

# ── Optional ───────────────────────────────────────────────────────────────
# 1 = Dev login button and sign-in codes in the log. Local only: ignored when BASE_URL is https:// or on Cloud Run.
DEV=1
# Secret for POST /tasks/reminders; needed only in webhook (https) mode.
# CRON_SECRET=
# Comma-separated account ids that see the in-app Statistics.
# ADMIN_USER_IDS=
# Max sign-in code emails per 24 hours across all addresses (protects a shared SMTP quota); default 200.
# EMAIL_DAILY_CAP=200
# json = one JSON line with severity per log record (Cloud Logging); default: json on Cloud Run, text elsewhere.
# LOG_FORMAT=text
# Send errors to your Sentry.
# SENTRY_DSN=
# Release name for Sentry events, e.g. gtd@1.2.0.
# SENTRY_RELEASE=
# Version shown in the footer, the app menu and /changes, e.g. 1.2.0; unset = "dev".
# APP_VERSION=
# Google Analytics 4 measurement ID; ignored outside the reference domain.
# GA_MEASUREMENT_ID=
# Comma-separated IPs/CIDRs of your own reverse proxies or load balancer with a public address; their
# X-Forwarded-For hops are skipped when finding the client IP for sign-in rate limits. Private, loopback and
# link-local proxies (Docker, Cloud Run) are trusted without it.
# TRUSTED_PROXIES=
# Set by Cloud Run itself (marks Sentry events as production); don't set by hand.
# K_SERVICE=
# Docker Compose only: host port (change BASE_URL along with it) and the bundled database password.
# PORT=8000
# POSTGRES_PASSWORD=gtd
