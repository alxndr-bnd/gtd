# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
BASE_URL=https://gtd.serbito.rs
TZ=Europe/Belgrade
# Необязательно: список Telegram ID через запятую. Если пусто — владельцем станет первый, кто напишет боту /start
ALLOWED_TG_IDS=

# Postgres (Cloud SQL, инстанс serbitodb, база gtd)
# Локально, через cloud-sql-proxy --port 5433:
DATABASE_URL=postgresql://gtd:ПАРОЛЬ@127.0.0.1:5433/gtd
# В Cloud Run — через unix-сокет:
# DATABASE_URL=postgresql://gtd:ПАРОЛЬ@/gtd?host=/cloudsql/serbito:europe-west1:serbitodb
